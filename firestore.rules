rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES — Hệ thống khảo sát năng suất dừa
//
// Cách deploy: copy nội dung file này vào Firebase Console → Firestore
// Database → tab "Rules" → dán đè → Publish. (Hoặc dùng Firebase CLI:
// `firebase deploy --only firestore:rules` nếu anh cài Firebase CLI sau này.)
//
// CƠ CHẾ TÀI KHOẢN (tự đăng ký + Admin duyệt):
//  - Khảo sát viên tự đăng ký trong app (email/mật khẩu tự chọn). Khi tạo
//    hồ sơ users/{uid}, CHỈ được phép tự gán role='field', status='pending'
//    (không thể tự phong Admin hoặc tự duyệt chính mình).
//  - Admin (tài khoản do Claude/anh Linh tạo trực tiếp trong Console, đã có
//    sẵn role='admin', status='approved') duyệt (approved) hoặc từ chối
//    (rejected) từng tài khoản chờ duyệt ngay trong Bảng điều khiển Admin.
//  - Chỉ tài khoản status='approved' mới được tạo/sửa phiếu khảo sát & cây.
//  - status='rejected' hoặc 'pending' vẫn đăng nhập được (Firebase Auth
//    không có cách chặn đăng nhập từ phía client-only), nhưng app sẽ tự
//    đăng xuất và chặn ngay khi phát hiện — mọi thao tác ghi dữ liệu khảo
//    sát cũng bị Rules chặn ở tầng server, nên không có rủi ro dữ liệu giả.
//
// YÊU CẦU CHỈNH SỬA PHIẾU (v1.2): phiếu được sửa tự do trong 48h đầu sau khi
// tạo. Sau đó, khảo sát viên phải gửi "yêu cầu chỉnh sửa" (chỉ đổi 3 trường
// editRequestStatus/editRequestNote/editRequestAt — xem isEditRequestUpdate),
// Admin duyệt (editApproved=true, editApprovedAt=now) mới mở thêm 48h để
// sửa thật sự (withinApprovedEditWindow). Khảo sát viên KHÔNG thể tự đặt
// editApproved=true.
//
// LƯU Ý KỸ THUẬT: các hàm helper (isSignedIn, isAdmin...) PHẢI khai báo BÊN
// TRONG khối `match /databases/{database}/documents { ... }` — không đặt ở
// ngoài cùng trước "service cloud.firestore {" — vì dùng biến $(database),
// biến này chỉ tồn tại (in scope) bên trong khối match đó. Đặt sai vị trí
// sẽ báo lỗi khi Publish: "Invalid variable name: database".
//
// v1.5 — RÀ SOÁT BẢO MẬT (Hub/Thùng rác/Loại trừ cây/Bản đồ):
//  - Trạng thái dự án 'trashed' (Thùng rác) và trường tree.excludedFromAnalysis
//    (loại trừ cây khỏi phân tích) đều được ghi qua `projects/{id}` và
//    `surveys/{id}/trees/{id}` — CẢ HAI đã được `allow write/update: if isAdmin()`
//    bên dưới bảo vệ sẵn (chỉ Admin mới xoá/khôi phục dự án, chỉ Admin mới bật/tắt
//    loại trừ cây), KHÔNG cần rule riêng.
//  - Rules này CHỈ bảo vệ được DỮ LIỆU (ai đọc/ghi được gì) — KHÔNG thể "giấu" mã
//    nguồn phía trình duyệt (View Source luôn xem được HTML/CSS/JS của mọi trang
//    web tĩnh, kể cả của Google/Facebook — đây là giới hạn kỹ thuật chung của web,
//    không phải lỗ hổng riêng của app này). Rủi ro copy giao diện KHÔNG đồng nghĩa
//    với rủi ro mất dữ liệu — hai việc tách biệt.
//  - Bổ sung khuyến nghị (làm trên Firebase Console, không sửa được bằng Rules):
//    (1) Google Cloud Console → APIs & Services → Credentials → giới hạn API key
//        Firebase theo "HTTP referrers" = đúng domain GitHub Pages đang triển khai,
//        để key không dùng được nếu bị sao chép sang site khác.
//    (2) Cân nhắc bật Firebase App Check (reCAPTCHA v3) để chặn bot/script gọi
//        thẳng vào Firestore API ngoài app thật.
//    (3) Định kỳ xem "Danh sách chờ duyệt" — chỉ duyệt tài khoản khảo sát viên
//        đúng là người trong công ty/dự án.
//  - Phía client (index.html) đã bổ sung escapeHtml() cho toàn bộ dữ liệu tự do
//    người dùng nhập (tên, ghi chú yêu cầu sửa phiếu, mã cây…) trước khi hiển thị,
//    để chặn XSS lưu trữ (một khảo sát viên chèn <script> vào ô nhập liệu rồi chạy
//    trong phiên của Admin khi Admin mở trang duyệt).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myUserData().status == 'approved';
    }

    function isAdmin() {
      return isApproved() && myUserData().role == 'admin';
    }

    function isOwner(existingData) {
      return isSignedIn() && existingData.createdBy == request.auth.uid;
    }

    function withinEditWindow(existingData) {
      // Cho sửa trong 48 giờ kể từ lúc tạo phiếu/cây.
      return request.time < existingData.createdAt + duration.value(48, 'h');
    }

    function withinApprovedEditWindow(existingData) {
      // Admin duyệt yêu cầu chỉnh sửa phiếu (ngoài cửa sổ 48h ban đầu) — cho sửa
      // thêm 48 giờ kể từ lúc Admin bấm Duyệt.
      return existingData.editApproved == true &&
        existingData.editApprovedAt != null &&
        request.time < existingData.editApprovedAt + duration.value(48, 'h');
    }

    function isEditRequestUpdate() {
      // Khảo sát viên gửi "yêu cầu chỉnh sửa phiếu": CHỈ được đổi đúng 3 trường
      // này (không được tự đổi editApproved hay bất kỳ dữ liệu phiếu nào khác).
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['editRequestStatus', 'editRequestNote', 'editRequestAt']) &&
        request.resource.data.editRequestStatus == 'pending';
    }

    // Hồ sơ người dùng (role: 'admin' | 'field'; status: 'pending' | 'approved' | 'rejected').
    // Tự đăng ký chỉ được tạo hồ sơ role='field', status='pending' cho chính
    // mình — không tự phong Admin, không tự duyệt. Admin gán role='admin' /
    // status='approved' thủ công qua Console cho tài khoản Admin đầu tiên.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid &&
                      request.resource.data.role == 'field' &&
                      request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Tham số cấu hình: phenology (T_max, nhịp ra buồng...) và mục tiêu KPI.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Dự án khảo sát (v1.4): admin tạo/lưu trữ, khảo sát viên approved chỉ cần ĐỌC để chọn
    // dự án đang nhập liệu. Chỉ tiêu KPI từng khảo sát viên nằm trong subcollection userTargets.
    match /projects/{projectId} {
      allow read: if isApproved();
      allow write: if isAdmin();

      match /userTargets/{uid} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow write: if isAdmin();
      }
    }

    // Kết quả tổng hợp thống kê (do tiến trình Python ghi vào, mục 6.5).
    match /results/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // tiến trình Python nên dùng Admin SDK
                                 // (bỏ qua rules) — quyền này chỉ để phòng
                                 // trường hợp ghi tay qua Console.
    }

    // Phiếu khảo sát (cấp vườn). Chỉ tài khoản đã được duyệt (approved) mới
    // được tạo phiếu/cây mới.
    match /surveys/{surveyId} {
      allow create: if isApproved();
      allow read: if isAdmin() || isOwner(resource.data);
      allow update: if isAdmin() ||
                      // Gửi yêu cầu chỉnh sửa (bất kỳ lúc nào, chỉ đổi 3 trường trạng thái):
                      (isOwner(resource.data) && isApproved() && isEditRequestUpdate()) ||
                      // Sửa dữ liệu phiếu thật sự: trong 48h đầu, hoặc trong 48h sau khi
                      // Admin duyệt yêu cầu chỉnh sửa:
                      (isOwner(resource.data) &&
                        (withinEditWindow(resource.data) || withinApprovedEditWindow(resource.data)));
      allow delete: if isAdmin();

      // Cây trong phiếu (cấp cây), kế thừa quyền theo phiếu cha.
      match /trees/{treeId} {
        allow create: if isApproved() &&
          isOwner(get(/databases/$(database)/documents/surveys/$(surveyId)).data);
        allow read: if isAdmin() ||
          isOwner(get(/databases/$(database)/documents/surveys/$(surveyId)).data);
        allow update: if isAdmin() ||
          (isOwner(get(/databases/$(database)/documents/surveys/$(surveyId)).data) &&
           withinEditWindow(resource.data));
        allow delete: if isAdmin();
      }
    }

    // Rule riêng cho truy vấn collectionGroup('trees') (Bảng điều khiển Admin
    // dùng để đếm tổng số cây) — Firestore CHỈ áp dụng rule lồng nhau ở trên
    // cho truy cập theo đường dẫn con trực tiếp (surveys/{id}/trees/{id}),
    // không tự áp dụng cho collectionGroup query; cần khai báo riêng với
    // {path=**} để Admin đọc được qua toàn bộ nhóm collection "trees".
    match /{path=**}/trees/{treeId} {
      allow read: if isAdmin();
    }
  }
}
